%% Activity Diagram — Admin: pengembalian alat (scan QR atau Peminjaman Aktif)
flowchart TB
    subgraph SY["Sistem"]
        direction TB
        y1[Tampilkan halaman Scan mode 'Kembali']
        y2[Tampilkan Peminjaman Aktif tab<br/>'Sedang dipinjam' / 'Terlambat':<br/>pita 'Terlambat N hari', tombol WhatsApp,<br/>tombol 'Catat Pengembalian']
        y3{Unit sedang dipinjam?}
        y4[Pesan merah: 'Unit tidak sedang<br/>dipinjam' / 'QR tidak dikenal']
        y5[Tampilkan transaksi pemegang unit:<br/>peminjam, rencana kembali,<br/>daftar unit yang belum kembali]
        y6[Tampilkan form per unit: centang,<br/>kondisi Baik/Rusak/Hilang, catatan,<br/>tanggal kembali default hari ini]
        y7[Buka WhatsApp dengan pesan<br/>pengingat terisi otomatis]
        y8{Tanggal kembali valid?<br/>tidak di masa depan &<br/>tidak sebelum serah-terima}
        y9[Tampilkan pesan error tanggal]
        y10[Hitung hari terlambat per unit;<br/>unit Baik → Tersedia, Rusak → Perbaikan,<br/>Hilang → Hilang; catat riwayat kondisi]
        y11{Semua unit<br/>sudah kembali?}
        y12[Peminjaman → Selesai]
        y13[Peminjaman tetap Dipinjam<br/>sisa unit ditunggu]
        y14[Email 'Pengembalian Dicatat'<br/>+ tanggal boleh mengajukan lagi<br/>bila terlambat; pesan sukses]
    end

    subgraph U["Admin"]
        direction TB
        s((●))
        c{Mulai dari?}
        u1[Klik 'Scan Barcode' →<br/>tab 'Pengembalian']
        u2[Scan QR unit yang dikembalikan]
        u3[Klik Transaksi →<br/>'Peminjaman Aktif']
        u4{Peminjam<br/>terlambat & belum datang?}
        u5[Klik tombol 'WhatsApp']
        u6[Klik 'Catat Pengembalian']
        u7[Periksa fisik alat, pilih kondisi,<br/>isi catatan bila rusak/hilang]
        u8[Klik 'Simpan Pengembalian']
        e((◉))
    end

    s --> c
    c -- "Scan" --> u1 --> y1 --> u2 --> y3
    y3 -- "Tidak" --> y4 --> u2
    y3 -- "Ya" --> y5 --> y6
    c -- "Menu" --> u3 --> y2 --> u4
    u4 -- "Ya" --> u5 --> y7 --> e
    u4 -- "Tidak, alat dibawa" --> u6 --> y6
    y6 --> u7 --> u8 --> y8
    y8 -- "Tidak" --> y9 --> u7
    y8 -- "Ya" --> y10 --> y11
    y11 -- "Ya" --> y12 --> y14
    y11 -- "Belum" --> y13 --> y14
    y14 --> e

    classDef mulai fill:#131E4A,stroke:#131E4A,color:#ffffff
    classDef aksi fill:#EEF1FB,stroke:#263C92,color:#131E4A
    classDef sistem fill:#ffffff,stroke:#263C92,color:#131E4A
    classDef pilih fill:#FED80B,stroke:#1E2F72,color:#131E4A
    classDef gagal fill:#FEF2F2,stroke:#DC2626,color:#7F1D1D
    class s,e mulai
    class u1,u2,u3,u5,u6,u7,u8 aksi
    class y1,y2,y5,y6,y7,y10,y12,y13,y14 sistem
    class c,y3,u4,y8,y11 pilih
    class y4,y9 gagal
    style U fill:#F7F8FD,stroke:#93A5E2,color:#263C92
    style SY fill:#ffffff,stroke:#93A5E2,color:#263C92
